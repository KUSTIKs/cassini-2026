DATABASE_URL=postgres://lifeline:lifeline@localhost:5433/lifeline
PORT=4000
WEB_ORIGIN=http://localhost:3000
# Signs session tokens; required in production (at least 16 characters).
SESSION_SECRET=dev-only-session-secret-change-me
# Demo sign-in (pick a user, no password). Turn off for anything real.
DEMO_SIGN_IN=true

# Crew routing (Flow 4/5). recorded = real OpenRouteService routes saved by `pnpm routes:record`, replayed
# offline (fixture for anything not recorded); fixture = offline schematic routes; ors = live OpenRouteService
# (free key at openrouteservice.org; API host is api.heigit.org since Nov 2026).
ROUTING=recorded
# ORS_API_KEY=
# ORS_BASE_URL=https://api.heigit.org/openrouteservice
# ORS_PROFILE=driving-car
# Replay crew start "lon,lat"; default is the Krnov fire station (OSM node 13992959691).
# CREW_START=17.6807149,50.0944742
# RECORDED_ROUTES_PATH=src/adapters/out/routing/fixtures/recorded-routes.json
