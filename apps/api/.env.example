DATABASE_URL=postgres://lifeline:lifeline@localhost:5433/lifeline
PORT=4000
WEB_ORIGIN=http://localhost:3000

# Crew routing (Flow 4/5). fixture = offline schematic routes; ors = live OpenRouteService (free key at
# openrouteservice.org); recorded = real ORS routes saved by `pnpm routes:record`, replayed offline.
ROUTING=fixture
# ORS_API_KEY=
# ORS_BASE_URL=https://api.openrouteservice.org
# ORS_PROFILE=driving-car
# Replay crew start "lon,lat"; default is the Krnov fire station (OSM node 13992959691).
# CREW_START=17.6807149,50.0944742
# RECORDED_ROUTES_PATH=src/adapters/out/routing/fixtures/recorded-routes.json
