{
  "name": "@firstreach/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsup",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/adapters/out/postgres/migrate.ts",
    "demo:register": "tsx scripts/generate-demo-register.ts",
    "users:bootstrap": "tsx scripts/bootstrap-users.ts",
    "data:flood-zones": "tsx scripts/fetch-flood-zones.ts",
    "data:gfm": "tsx scripts/fetch-gfm-extent.ts"
  },
  "dependencies": {
    "@firstreach/contracts": "workspace:*",
    "@hono/node-server": "^2.1.11",
    "csv-parse": "^7.0.3",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.23",
    "postgres": "^4.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@firstreach/tsconfig": "workspace:*",
    "@types/d3-contour": "^3.0.6",
    "@types/node": "^26.6.11",
    "d3-contour": "^4.0.3",
    "drizzle-kit": "^0.31.11",
    "geotiff": "^3.0.5",
    "proj4": "^2.23.0",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.1.2"
  }
}
