{
  "name": "firstreach",
  "private": true,
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:migrate": "turbo run db:migrate --filter=@firstreach/api"
  },
  "devDependencies": {
    "turbo": "^2.11.13"
  }
}
